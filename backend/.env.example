NODE_ENV=development
PORT=4000
APP_URL=http://localhost:3000

# Transactions require a replica set. A standalone mongod cannot run them.
#   mongod --replSet rs0 --dbpath ./data --bind_ip 127.0.0.1
#   mongosh --eval "rs.initiate({_id:'rs0',members:[{_id:0,host:'127.0.0.1:27017'}]})"
MONGODB_URI=mongodb://127.0.0.1:27017/chapaimango?replicaSet=rs0&directConnection=true

JWT_ACCESS_SECRET=replace-with-32-byte-hex-secret
JWT_REFRESH_SECRET=replace-with-a-different-32-byte-hex
ACCESS_TOKEN_TTL=15m
REFRESH_TOKEN_TTL_DAYS=30

COOKIE_SECURE=false
TRUST_PROXY=0

# Owner seed account
OWNER_NAME=Owner
OWNER_PHONE=01700000000
OWNER_PASSWORD=changeme123

# Optional integrations. The app boots without them and reports them as unconfigured.
# Cloudflare R2 (S3 compatible). The bucket must be PRIVATE: KYC scans and deposit
# screenshots are reachable only through short-lived signed URLs.
R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET=
# A SEPARATE bucket for customer-facing images. R2 public access is bucket wide,
# so product photos cannot share a bucket with national ID scans. Leave this
# empty and product image uploads are refused with a clear message.
R2_PUBLIC_BUCKET=
# Every object this app writes goes under this prefix, so the bucket stays tidy
# and a second environment can share it. Use a different value for staging.
R2_PREFIX=chapaimango
# Where the bucket is exposed for customer-facing images (product photos, logos).
# An r2.dev subdomain or your own domain. Private files never use this.
R2_PUBLIC_BASE_URL=

# ImgBB hosts every image the public may see: product photographs, shop logos
# and brand assets. Free, no bucket, no signing, no egress bill. Get a key at
# https://api.imgbb.com. Nothing private goes here: an ImgBB link is readable by
# anyone who has it, forever, so KYC scans and deposit screenshots stay in R2.
# With this set, the R2 public bucket above is not needed at all.
IMGBB_API_KEY=
IMGBB_UPLOAD_URL=https://api.imgbb.com/1/upload
IMGBB_TIMEOUT_MS=20000

VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=mailto:support@example.com

SMS_API_URL=https://api.automas.com.bd/smsapiv3
SMS_BALANCE_URL=https://api.automas.com.bd/
SMS_API_KEY=
SMS_SENDER_ID=

TELEGRAM_BOT_TOKEN=
TELEGRAM_BOT_USERNAME=
