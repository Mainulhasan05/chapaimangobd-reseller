NODE_ENV=development
PORT=4000
APP_URL=http://localhost:3000

# Extra browser origins allowed to call this API cross-origin, comma separated.
# APP_URL is already allowed, so leave this empty unless a second origin exists,
# such as a phone on the LAN: http://192.168.0.12:3000,http://staging.example.com
# Development only; in production the browser talks to Next, not to this API.
CORS_ORIGINS=

# Transactions require a replica set. A standalone mongod cannot run them.
#   mongod --replSet rs0 --dbpath ./data --bind_ip 127.0.0.1
#   mongosh --eval "rs.initiate({_id:'rs0',members:[{_id:0,host:'127.0.0.1:27017'}]})"
MONGODB_URI=mongodb://127.0.0.1:27017/chapaimango?replicaSet=rs0&directConnection=true

# At least 32 characters each, and the two must differ; boot refuses otherwise.
# Generate each with: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
JWT_ACCESS_SECRET=replace-with-32-byte-hex-secret-0000000000000000
JWT_REFRESH_SECRET=replace-with-a-different-32-byte-hex-1111111111111
# Optional. Mixed into stored one-time-code hashes; falls back to JWT_REFRESH_SECRET.
# At least 32 characters when set.
OTP_PEPPER=
# The owner's new-device SMS code (docs/adr/0014). false only for local development;
# boot refuses false with NODE_ENV=production.
OWNER_DEVICE_OTP=true
ACCESS_TOKEN_TTL=15m
REFRESH_TOKEN_TTL_DAYS=30

# Leave unset to follow NODE_ENV: secure cookies in production, plain on
# localhost. Setting it to false with NODE_ENV=production is refused at boot.
COOKIE_SECURE=false
# Proxies in front of the Next server that append X-Forwarded-For (nginx, a load
# balancer, Cloudflare). Next's /api rewrite adds no hop. 0 when nothing is in front.
TRUST_PROXY=0

# pino level: fatal, error, warn, info, debug, trace. Silent under NODE_ENV=test.
LOG_LEVEL=info

# Owner seed account
OWNER_NAME=Owner
OWNER_PHONE=01700000000
OWNER_PASSWORD=changeme123

# Optional integrations. The app boots without them and reports them as unconfigured.
# Cloudflare R2 (S3 compatible). The bucket must be PRIVATE: KYC scans and deposit
# screenshots are reachable only through short-lived signed URLs.
R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET=
# A SEPARATE bucket for customer-facing images. R2 public access is bucket wide,
# so product photos cannot share a bucket with national ID scans. Leave this
# empty and product image uploads are refused with a clear message.
R2_PUBLIC_BUCKET=
# Every object this app writes goes under this prefix, so the bucket stays tidy
# and a second environment can share it. Use a different value for staging.
R2_PREFIX=chapaimango
# Where the bucket is exposed for customer-facing images (product photos, logos).
# An r2.dev subdomain or your own domain. Private files never use this.
R2_PUBLIC_BASE_URL=

# ImgBB hosts every image the public may see: product photographs, shop logos
# and brand assets. Free, no bucket, no signing, no egress bill. Get a key at
# https://api.imgbb.com. Nothing private goes here: an ImgBB link is readable by
# anyone who has it, forever, so KYC scans and deposit screenshots stay in R2.
# With this set, the R2 public bucket above is not needed at all.
IMGBB_API_KEY=
IMGBB_UPLOAD_URL=https://api.imgbb.com/1/upload
IMGBB_TIMEOUT_MS=20000

VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=mailto:support@example.com

# Automas, the SMS gateway. Bengali text is Unicode, which caps a segment at 70
# characters against 160, so a Bengali message costs roughly twice what the same
# sentence costs in Latin script. Every message sent is recorded in SmsLog and
# shown in the owner's SMS panel, whatever the outcome.
SMS_API_URL=https://api.automas.com.bd/smsapiv3
SMS_BALANCE_URL=https://api.automas.com.bd/getbalance
AUTOMAS_API_KEY=
AUTOMAS_SENDER_ID=
# The original names for the two above. Still read, so an existing .env keeps
# working; set the AUTOMAS_ pair on anything new.
SMS_API_KEY=
SMS_SENDER_ID=

# Where customers reach the site. Used for the tracking link in customer SMS
# ({trackUrl} = PUBLIC_APP_URL/track?code=CODE). Leave empty and the link is
# simply left out of the message.
PUBLIC_APP_URL=

TELEGRAM_BOT_TOKEN=
# Without the @. Optional: read from the bot (getMe) when empty.
TELEGRAM_BOT_USERNAME=
# Leave empty to poll (only in a RUN_JOBS=true process holding a MongoDB lease).
# Set to this API's public base URL to use a webhook instead; the secret is then
# required, 16-256 characters of A-Z a-z 0-9 _ -.
TELEGRAM_WEBHOOK_URL=
TELEGRAM_WEBHOOK_SECRET=

# Scheduled jobs: 02:00 ledger reconciliation, 03:00 KYC scan purge, 09:00 owner
# digest (Asia/Dhaka). Off unless true. Each run takes a MongoDB lock, so setting
# it on every instance is safe; leaving it off everywhere means the jobs never run.
RUN_JOBS=false
# The digest warns the owner when the SMS gateway balance drops below this.
# Automas reports remaining messages, not taka, so this is a message count.
SMS_LOW_BALANCE=200
